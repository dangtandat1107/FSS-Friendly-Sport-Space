@model List<Court>
@{ ViewData["Title"] = "Quản lý sân"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Quản lý sân</h3>
  <a class="btn btn-success" asp-action="Create">Thêm sân</a>
</div>
<table class="table align-middle">
  <tr><th>Sân</th><th>Môn</th><th>Quận</th><th>Giá mỗi giờ</th><th>Trạng thái</th><th></th></tr>
  @foreach (var c in Model)
  {
    var m = c.SportType.Meta();
    <tr>
      <td class="fw-semibold">@c.Name</td>
      <td><span class="badge" style="background:@m.Color">@m.Label</span></td>
      <td>@c.District</td>
      <td>@c.PricePerHour.ToString("N0") đ</td>
      <td><span class="badge @(c.Status == CourtStatus.Active ? "bg-success" : "bg-warning text-dark")">@c.Status.DisplayName()</span></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
        <form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline">
          <button class="btn btn-sm btn-outline-secondary">@(c.Status == CourtStatus.Active ? "Chuyển sang bảo trì" : "Mở lại sân")</button>
        </form>
      </td>
    </tr>
  }
</table>
