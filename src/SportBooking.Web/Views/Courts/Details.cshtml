@inject SportBooking.Web.Services.IImageStore Images
@model CourtDetailsVm
@{
    var c = Model.Court;
    var m = c.SportType.Meta();
    var now = DateTime.Now;
    ViewData["Title"] = c.Name;
    string[] dow = { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    var image = Images.GetUrl("courts", c.Id.ToString()) ?? m.Image;   // ảnh riêng của sân, không có thì dùng ảnh của môn
}
<div style="--sport:@m.Color">
  <section class="court-banner mb-4">
    <img src="@image" alt="Ảnh sân @c.Name" />
    <div class="inner">
      <div class="fw-semibold">@m.Label</div>
      <h1>@c.Name</h1>
      <div class="mt-2">@foreach (var t in CourtOptions.Tags(c)) { <span class="tag">@t</span> }</div>
      <div class="mt-2">@c.District, @c.Address. <b>@c.PricePerHour.ToString("N0") đ/giờ</b></div>
      <div class="mt-1">@if (c.ReviewCount > 0) { <b>@c.AvgRating.GetValueOrDefault().Stars()</b> <span>(@c.ReviewCount đánh giá)</span> } else { <span>Chưa có đánh giá</span> }</div>
    </div>
  </section>

  @if (c.Status == CourtStatus.Maintenance)
  {
    <div class="alert alert-warning">Sân đang bảo trì, tạm thời không nhận đặt.</div>
  }

  <h4>Chọn ngày</h4>
  <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    @for (var i = 0; i < 7; i++)
    {
      var d = DateTime.Today.AddDays(i);
      <a class="day-chip @(d == Model.Date.Date ? "active" : "")" asp-action="Details" asp-route-id="@c.Id" asp-route-date="@d.ToString("yyyy-MM-dd")">
        <b>@(i == 0 ? "Nay" : dow[(int)d.DayOfWeek])</b><small>@d.ToString("dd/MM")</small>
      </a>
    }
    <form method="get" class="ms-md-2">
      <input type="date" name="date" class="form-control form-control-sm" value="@Model.Date.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" aria-label="Chọn ngày khác" onchange="this.form.submit()" />
    </form>
  </div>

  @if (Model.Date.Date == DateTime.Today && now > DateTime.Today.AddHours(IBookingService.CloseHour - 1))
  {
    <div class="alert alert-info">Hôm nay đã hết khung giờ có thể đặt. Hãy chọn một ngày khác ở phía trên.</div>
  }

  <h4>Khung giờ ngày @Model.Date.ToString("dd/MM/yyyy")</h4>
  @await Html.PartialAsync("_CalendarGrid", Model.Calendar)
  <div class="small mt-2"><a asp-action="Calendar" asp-route-sport="@c.SportType" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Xem lịch của tất cả sân @m.Label.ToLower()</a></div>

  @if (User.Identity?.IsAuthenticated != true)
  {
    <div class="panel-card p-3">
      <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập</a> bằng tài khoản khách hàng để chọn khung giờ và đặt sân.
    </div>
  }

  <h4 class="mt-5 mb-3">Đánh giá từ khách đã đặt sân</h4>
  @if (Model.Reviews.Count == 0)
  {
    <div class="panel-card p-3 text-muted">Chưa có đánh giá nào. Sau khi chơi xong, khách có thể đánh giá sân trong mục "Lịch của tôi".</div>
  }
  else
  {
    <div class="d-grid gap-2">
      @foreach (var r in Model.Reviews)
      {
        <div class="panel-card p-3">
          <div class="d-flex justify-content-between">
            <b>@(r.Customer?.FullName ?? "Khách")</b>
            <span class="text-muted small">@r.CreatedAt.ToString("dd/MM/yyyy")</span>
          </div>
          <div class="rating-stars" aria-label="@r.Rating trên 5 sao">@(new string('★', r.Rating))<span class="off">@(new string('★', 5 - r.Rating))</span></div>
          @if (!string.IsNullOrWhiteSpace(r.Comment)) { <div class="mt-1" style="white-space:pre-line">@r.Comment</div> }
        </div>
      }
    </div>
  }
</div>
