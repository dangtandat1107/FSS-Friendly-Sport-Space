@inject SportBooking.Web.Services.IImageStore Images
@model Court
@{
    var m = Model.SportType.Meta();
    var image = Images.GetUrl("courts", Model.Id.ToString()) ?? m.Image;   // ảnh riêng của sân, không có thì dùng ảnh của môn
}
<article class="court-card" style="--sport:@m.Color">
  <div class="thumb">
    <img src="@image" alt="Sân @Model.Name" loading="lazy" />
    <span class="price">@Model.PricePerHour.ToString("N0") đ/giờ</span>
  </div>
  <div class="p-3 d-flex flex-column flex-grow-1">
    <div class="small fw-semibold" style="color:var(--sport)">@m.Label</div>
    <h5 class="mb-1">@Model.Name</h5>
    <div class="small mb-1">
      @if (Model.ReviewCount > 0) { <b>@Model.AvgRating.GetValueOrDefault().Stars()</b> <span class="text-muted">(@Model.ReviewCount đánh giá)</span> }
      else { <span class="text-muted">Chưa có đánh giá</span> }
    </div>
    <div class="text-muted small mb-2">@Model.District, @Model.Address</div>
    <div>
      @foreach (var t in CourtOptions.Tags(Model)) { <span class="tag">@t</span> }
    </div>
    <div class="mt-auto pt-3 d-flex align-items-center justify-content-between">
      @if (Model.Status == CourtStatus.Maintenance) { <span class="badge bg-warning text-dark">Đang bảo trì</span> }
      else { <span class="small text-muted">Đang mở đặt</span> }
      <a class="btn btn-sm btn-outline-success" asp-controller="Courts" asp-action="Details" asp-route-id="@Model.Id">Xem lịch trống</a>
    </div>
  </div>
</article>
