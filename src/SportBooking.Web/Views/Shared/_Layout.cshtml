@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var avatarUrl = User.FindFirst("Avatar")?.Value;
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?"
        : fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[..1].ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - FSS</title>
  <script>
    // Áp dụng giao diện tối ngay từ đầu để trang không bị nháy sáng khi tải lại
    (function () {
      try { if (localStorage.getItem('fss-theme') === 'dark') document.documentElement.setAttribute('data-bs-theme', 'dark'); } catch (e) { }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
  <link href="~/css/courts.css" rel="stylesheet" />
  <link href="~/css/dark.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg site-nav">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
      <svg width="34" height="24" viewBox="0 0 32 22" aria-hidden="true">
        <rect x="1" y="1" width="30" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2.2" />
        <line x1="16" y1="1" x2="16" y2="21" stroke="currentColor" stroke-width="2.2" />
        <circle cx="16" cy="11" r="3.5" fill="none" stroke="currentColor" stroke-width="2.2" />
      </svg>
      <span><span class="brand-name">FSS</span><span class="brand-sub">Friendly Sport Space</span></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto ms-lg-3">
        <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Index">Tìm sân</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Calendar">Lịch trống</a></li>
        @if (User.IsInRole("Customer")) { <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="My">Lịch của tôi</a></li> }
        @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Manage">Quản lý sân</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Manage">Duyệt lịch</a></li>
        }
        @if (User.IsInRole("Owner") || User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Incidents" asp-action="Manage">Sự cố</a></li>
        }
        @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li> }
      </ul>
      <div class="d-flex align-items-center gap-2">
        <button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="false" aria-label="Chuyển sang giao diện tối" title="Chuyển sang giao diện tối">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="dropdown">
            <a class="btn btn-sm btn-outline-success dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
              @if (avatarUrl != null) { <img class="avatar avatar-sm" src="@avatarUrl" alt="" /> }
              else { <span class="avatar avatar-sm">@initial</span> }
              @fullName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Hồ sơ của tôi</a></li>
              <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index" asp-route-tab="password">Đổi mật khẩu</a></li>
              @if (User.IsInRole("Customer"))
              {
                <li><a class="dropdown-item" asp-controller="Bookings" asp-action="My">Lịch của tôi</a></li>
                <li><a class="dropdown-item" asp-controller="Incidents" asp-action="My">Báo cáo sự cố của tôi</a></li>
              }
              <li><hr class="dropdown-divider" /></li>
              <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">Đăng xuất</button></form></li>
            </ul>
          </div>
        }
        else
        {
          <a class="btn btn-sm btn-outline-success me-2" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <a class="btn btn-sm btn-success" asp-controller="Account" asp-action="Register">Đăng ký</a>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Msg"] != null) { <div class="alert alert-success">@TempData["Msg"]</div> }
  @if (TempData["Err"] != null) { <div class="alert alert-danger">@TempData["Err"]</div> }
  @RenderBody()
</main>
<footer class="container text-center site-footer py-4">FSS - Friendly Sport Space. Đồ án chuyên ngành, HUTECH.</footer>
@{ var pollsIncidents = User.IsInRole("Staff") || User.IsInRole("Owner") || User.IsInRole("Admin"); }
<div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true" data-incident-poll="@(pollsIncidents ? Url.Action("Poll", "Incidents") : null)"></div>
@if (TempData["Toast"] is string toastMessage)
{
  <div id="toast-data" data-message="@toastMessage" hidden></div>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
