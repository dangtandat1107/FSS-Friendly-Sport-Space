@model HomeVm
@{ ViewData["Title"] = "Trang chủ"; }

<section class="hero">
  <h1>Chọn sân.<br />Chọn giờ.<br />Ra sân.</h1>
  <p class="hero-copy">Đặt sân cầu lông, bóng đá, tennis, pickleball và bóng rổ. Giữ chỗ @IBookingService.PaymentTimeoutMinutes phút, thanh toán bằng mã QR.</p>
  <form asp-controller="Courts" asp-action="Index" method="get" class="hero-search">
    <select name="sport" class="form-select" aria-label="Môn thể thao">
      <option value="">Tất cả các môn</option>
      @foreach (var s in SportInfo.All) { <option value="@s">@s.DisplayName()</option> }
    </select>
    <input name="district" class="form-control" placeholder="Quận, ví dụ Quận 1" aria-label="Quận" />
    <button class="btn btn-lime px-4">Tìm sân</button>
  </form>
</section>

<h2 class="section-title">Chọn môn bạn chơi</h2>
<div class="sport-grid">
  @foreach (var s in SportInfo.All)
  {
    var m = s.Meta();
    var count = Model.CountBySport.TryGetValue(s, out var n) ? n : 0;
    <a class="sport-tile" style="--sport:@m.Color" asp-controller="Courts" asp-action="Index" asp-route-sport="@s">
      <img src="@m.Image" alt="" loading="lazy" />
      <div class="label">
        <div class="name">@m.Label</div>
        <div class="count">@(count > 0 ? $"{count} sân đang mở" : "Sắp có sân")</div>
      </div>
    </a>
  }
</div>

@if (Model.Featured.Any())
{
  <div class="d-flex align-items-end justify-content-between section-title">
    <h2 class="mb-0">Sân đang mở đặt</h2>
    <a asp-controller="Courts" asp-action="Index">Xem tất cả sân</a>
  </div>
  <div class="row g-3">
    @foreach (var c in Model.Featured)
    {
      <div class="col-md-6 col-lg-4">@await Html.PartialAsync("_CourtCard", c)</div>
    }
  </div>
}

<h2 class="section-title">Đặt sân trong ba bước</h2>
<div class="steps">
  <div><div class="step-no">1</div><h5 class="mt-1">Chọn sân và giờ</h5><p class="text-muted mb-0">Xem lịch trống theo ngày, bấm vào khung giờ bạn muốn chơi.</p></div>
  <div><div class="step-no">2</div><h5 class="mt-1">Giữ chỗ và quét mã QR</h5><p class="text-muted mb-0">Chỗ được giữ @IBookingService.PaymentTimeoutMinutes phút. Mã QR đã điền sẵn số tiền và nội dung.</p></div>
  <div><div class="step-no">3</div><h5 class="mt-1">Chủ sân xác nhận</h5><p class="text-muted mb-0">Chủ sân đối chiếu khoản chuyển và xác nhận. Bạn xem lịch trong mục Lịch của tôi.</p></div>
</div>
