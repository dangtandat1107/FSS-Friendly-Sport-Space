@model GatewayVm
@{
    ViewData["Title"] = "Chuyển khoản";
    var p = Model.Payment;
    var isMomo = p.Method == PaymentMethod.Momo;
    var awaiting = p.Status == PaymentStatus.AwaitingConfirmation;
}
<div class="row justify-content-center"><div class="col-lg-6">

  @if (awaiting)
  {
    <div class="alert alert-info"><b>Đã ghi nhận.</b> Đang chờ chủ sân kiểm tra và xác nhận đã nhận tiền. Bạn sẽ thấy lịch chuyển sang "Đã xác nhận" trong mục Lịch của tôi.</div>
  }
  else if (Model.IsDemo)
  {
    <div class="alert alert-info"><b>Chế độ minh họa.</b> Chưa cấu hình tài khoản nhận tiền. Khi demo, chủ sân (owner@demo.com) vào mục Duyệt lịch để xác nhận.</div>
  }

  <div class="card panel-card"><div class="card-body p-4">
    <h4 class="mb-3">@p.Method.DisplayName()</h4>

    <div class="text-center mb-3">
      @if (Model.QrKind == QrKind.Dynamic)
      {
        <img src="@Model.QrDataUri" alt="Mã QR chuyển khoản đến @Model.BankName" style="width:240px;height:240px;" />
        <div class="small text-muted mt-1">Quét bằng app của bất kỳ ngân hàng nào, tiền sẽ vào tài khoản <b>@Model.BankName</b> của @Model.AccountName. Số tiền và nội dung đã được điền sẵn.</div>
        <div class="small text-muted">Mã theo chuẩn VietQR (NAPAS 247).</div>
      }
      else if (Model.QrKind == QrKind.Static)
      {
        <img src="@Model.QrImagePath" alt="Mã QR thanh toán" style="width:220px;height:220px;" />
        <div class="small text-muted mt-1">Mã QR chưa gắn sẵn số tiền, hãy nhập đúng số tiền và nội dung bên dưới.</div>
      }
      else
      {
        <div class="fake-qr @(isMomo ? "fake-qr-momo" : "")">Mã QR minh họa</div>
      }
    </div>

    <table class="table">
      <tr><th style="width:35%">@(isMomo ? "Ví nhận" : "Ngân hàng")</th><td>@Model.BankName</td></tr>
      <tr><th>@(isMomo ? "Số điện thoại" : "Số tài khoản")</th><td>@Model.AccountNo</td></tr>
      <tr><th>Chủ tài khoản</th><td>@Model.AccountName</td></tr>
      <tr><th>Số tiền</th><td class="fw-bold">@p.Amount.ToString("N0") đ</td></tr>
      <tr><th>Nội dung</th><td><code>@p.TransactionCode</code></td></tr>
      <tr><th>Sân</th><td>@(p.Booking?.Court?.Name)</td></tr>
      <tr><th>Thời gian</th><td>@(p.Booking?.StartTime.ToString("dd/MM/yyyy HH:mm")) - @(p.Booking?.EndTime.ToString("HH:mm"))</td></tr>
      @if (p.Booking?.ExpiresAt != null)
      {
        <tr><th>@(awaiting ? "Giữ chỗ đến" : "Hạn thanh toán")</th><td>@(p.Booking?.ExpiresAt?.ToString("HH:mm"))</td></tr>
      }
    </table>

    @if (!awaiting)
    {
      <form asp-action="ReportTransfer" method="post">
        <input type="hidden" name="paymentId" value="@p.Id" />
        <button class="btn btn-success w-100">Tôi đã chuyển khoản</button>
      </form>
      <div class="small text-muted mt-2">Chỉ bấm sau khi bạn đã chuyển tiền. Chủ sân sẽ đối chiếu với tài khoản ngân hàng rồi xác nhận.</div>
      <div class="text-center mt-3"><a asp-action="Pay" asp-route-bookingId="@p.BookingId">Đổi phương thức</a></div>
    }
    else
    {
      <a class="btn btn-outline-success w-100" asp-controller="Bookings" asp-action="My">Về lịch của tôi</a>
    }
  </div></div>
</div></div>
